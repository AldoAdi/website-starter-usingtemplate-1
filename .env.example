# Web3Forms access key. Public by design: it identifies the destination
# inbox and is visible in the page source of any deployed site. Spam
# control is the honeypot plus Web3Forms' own filtering, not secrecy.
NEXT_PUBLIC_WEB3FORMS_KEY=

# GA4 measurement ID. Optional -- analytics stays disabled when unset.
NEXT_PUBLIC_GA_ID=

# The third-party scheduler the /book route hands off to. Every ad, listing
# and printed card should point at /book instead of this URL -- that is what
# makes the scheduler swappable without reprinting anything.
NEXT_PUBLIC_BOOKING_URL=

# First-party endpoint for funnel events. Leave blank to run on GA4 alone.
# Setting it adds the http sink -- but that needs a route handler, which
# needs a Node runtime, so it cannot be used with the github-pages target.
NEXT_PUBLIC_BOOKING_INGEST_URL=
